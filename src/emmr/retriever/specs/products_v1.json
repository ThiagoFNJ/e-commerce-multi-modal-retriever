{
  "schema_version": "products_v1",
  "server_version": "1.15.1",
  "description": "One point per product; the 4 faces as named vectors + payload (system-design.md §1-§3, retriever-module-design.md §2). Any change here (or in the encoder manifest) changes the fingerprint => new physical collection + full re-ingest + alias flip.",
  "alias": "products",
  "encoders": {
    "text_dense": {"model": "BAAI/bge-small-en-v1.5", "revision": "5c38ec7c405ec4b44b94cc5a9bb96e735b38267a", "dim": 384, "normalize": true, "prompt_convention": "query:/passage:"},
    "image": {"model": "google/siglip-base-patch16-224", "revision": "7fd15f0689c79d79e38b1c2e2e2370a7bf2761ed", "dim": 768, "normalize": true}
  },
  "vectors": {
    "text_dense": {"size": 384, "distance": "Cosine", "hnsw_m": 16, "on_disk": false,
                   "quantization": {"scalar": {"type": "int8", "always_ram": true}}},
    "review_sent": {"size": 384, "distance": "Cosine", "multivector": "max_sim", "hnsw_m": 0, "on_disk": true,
                    "quantization": {"scalar": {"type": "int8", "always_ram": false}}},
    "aspect_dense": {"size": 384, "distance": "Cosine", "multivector": "max_sim", "hnsw_m": 0, "on_disk": true},
    "image": {"size": 768, "distance": "Cosine", "hnsw_m": 0, "on_disk": true}
  },
  "sparse_vectors": {
    "text_sparse": {"modifier": "idf"}
  },
  "payload_indexes": {
    "asin": "keyword",
    "cat_top": "keyword",
    "brand": "keyword",
    "color": "keyword",
    "locale": "keyword",
    "price": "float",
    "n_ratings": "integer"
  }
}
